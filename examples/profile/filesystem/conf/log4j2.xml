<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT" follow="true">
            <PatternLayout disableAnsi="false"
                           pattern="%highlight{%d{HH:mm:ss.SSS} [%t] %-5level %logger{1} - %msg%n}{FATAL=red, ERROR=red, WARN=yellow, INFO=green, DEBUG=blue, TRACE=white}"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="io.descoped.dc" level="TRACE"/>
        <Logger name="io.descoped.dc.content" level="TRACE"/>
        <Logger name="io.descoped.rawdata.api" level="TRACE"/>

        <Root level="TRACE">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
