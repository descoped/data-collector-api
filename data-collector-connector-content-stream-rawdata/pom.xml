<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.dc</groupId>
        <artifactId>data-collector-project</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>data-collector-connector-content-stream-rawdata</artifactId>
    <packaging>jar</packaging>

    <name>Data Collector Connector Content Stream Rawdata</name>
    <description>Content store provider `rawdata`: writes the collected content to rawdata-client topics, optionally encrypted.</description>

    <properties>
        <!-- Lint and doclint groups this module still breaks (javac -Xlint:all -Werror, Javadoc doclint all with
             warnings failing); its revision empties both lists. -->
        <doclint.exclusions>,-missing</doclint.exclusions>
        <lint.exclusions>,-missing-explicit-ctor,-requires-automatic,-try</lint.exclusions>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.descoped.dc</groupId>
            <artifactId>data-collector-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-api</artifactId>
            <version>${rawdata-client.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.encryption</groupId>
            <artifactId>encryption-util</artifactId>
            <version>${encryption-util.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.secrets</groupId>
            <artifactId>secrets-client-api</artifactId>
            <version>${secrets-client-api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.secrets</groupId>
            <artifactId>secrets-provider-dynamic-configuration</artifactId>
            <version>${secrets-provider.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
