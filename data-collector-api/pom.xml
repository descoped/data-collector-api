    <artifactId>data-collector-api</artifactId>
    <packaging>jar</packaging>

    <name>Data Collector API</name>
    <description>The data collector specification DSL (builders and nodes), its expression language, and the service interfaces for HTTP, content stores and health.</description>

    <properties>
        <!-- Lint and doclint groups this module still breaks (javac -Xlint:all -Werror, Javadoc doclint all with
             warnings failing); its revision empties both lists. -->
        <doclint.exclusions>,-missing</doclint.exclusions>
        <lint.exclusions>,-cast,-deprecation,-missing-explicit-ctor,-rawtypes,-requires-automatic,-requires-transitive-automatic,-serial,-try,-unchecked</lint.exclusions>
    </properties>

