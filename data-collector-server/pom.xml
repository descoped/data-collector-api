<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.dc</groupId>
        <artifactId>data-collector-project</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>data-collector-server</artifactId>
    <packaging>jar</packaging>

    <name>Data Collector Server</name>
    <description>The data collector server: runs specifications as tasks over HTTP, with integrity check and recovery of rawdata topics.</description>

    <properties>
        <!-- Lint and doclint groups this module still breaks (javac -Xlint:all -Werror, Javadoc doclint all with
             warnings failing); its revision empties both lists. -->
        <doclint.exclusions>,-missing</doclint.exclusions>
        <lint.exclusions>,-deprecation,-missing-explicit-ctor,-opens,-rawtypes,-requires-automatic,-requires-transitive-automatic,-try,-unchecked</lint.exclusions>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.descoped.dc</groupId>
            <artifactId>data-collector-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.dc</groupId>
            <artifactId>data-collector-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.dc</groupId>
            <artifactId>data-collector-server-base</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.dc</groupId>
            <artifactId>data-collector-connector-content-stream-rawdata</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-api</artifactId>
            <version>${rawdata-client.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-provider-filesystem</artifactId>
            <version>${rawdata-client.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-provider-gcs</artifactId>
            <version>${rawdata-client.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-provider-postgres</artifactId>
            <version>${rawdata-client.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.config</groupId>
            <artifactId>dynamic-configuration</artifactId>
            <version>${dynamic-configuration.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.secrets</groupId>
            <artifactId>secrets-client-api</artifactId>
            <version>${secrets-client-api.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.secrets</groupId>
            <artifactId>secrets-provider-google-secret-manager</artifactId>
            <version>${secrets-provider.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
            <version>${classgraph.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lmdbjava</groupId>
            <artifactId>lmdbjava</artifactId>
            <version>${lmdbjava.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jcl-over-slf4j</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j2.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lmax</groupId>
            <artifactId>disruptor</artifactId>
            <version>${disruptor.version}</version>
        </dependency>
        <dependency>
            <groupId>org.fusesource.jansi</groupId>
            <artifactId>jansi</artifactId>
            <version>${jansi.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.jnr</groupId>
            <artifactId>jffi</artifactId>
            <version>${jffi.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.descoped.dc</groupId>
            <artifactId>data-collector-testutils</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.xml.bind</groupId>
                    <artifactId>jakarta.xml.bind-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.activation</groupId>
                    <artifactId>jakarta.activation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        -XX:+EnableDynamicAgentLoading
                        --add-opens=io.descoped.dc.server/io.descoped.dc.server.task=ALL-UNNAMED
                        --add-reads io.descoped.dc.content.rawdata=io.descoped.dc.core
                        --add-exports
                        io.descoped.rawdata.postgres/io.descoped.rawdata.provider.postgres=io.descoped.service.provider.api,io.descoped.dc.server
                        -Xmx1500m
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
