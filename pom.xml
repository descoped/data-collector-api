<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent and aggregator of every module. All modules share this version and are released together. -->
    <groupId>io.descoped.dc</groupId>
    <artifactId>data-collector-project</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Data Collector Project</name>
    <description>Data Collector: a specification driven HTTP crawler that pages through APIs and writes the content to
        rawdata-client topics. The specification DSL and its API, the execution engine, the rawdata content stream,
        the server and its test utilities.
    </description>
    <url>https://github.com/descoped/data-collector-project</url>
    <inceptionYear>2019</inceptionYear>

    <modules>
        <module>data-collector-bom</module>
        <module>data-collector-api</module>
        <module>data-collector-server-base</module>
        <module>data-collector-testutils</module>
        <module>data-collector-connector-content-stream-rawdata</module>
        <module>data-collector-core</module>
        <module>data-collector-server</module>
        <module>data-collector-samples</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Reproducible builds: every jar entry gets this time, so the same tag builds the same bytes.
             release:prepare sets it to the release time. -->
        <project.build.outputTimestamp>2026-11-18T12:00:00Z</project.build.outputTimestamp>
        <!-- -Xlint:all -Werror is the rule. A module that is not yet revised lists the lint categories it still
             breaks here, as ",-unchecked,-rawtypes" and so on; its revision empties the list. -->
        <lint.exclusions/>
        <doclint.exclusions/>

        <!-- Dependency versions. Kept as properties, not in dependencyManagement, so that importing
             data-collector-bom (which inherits this POM) manages the data collector modules only. -->

        <!-- The Descoped libraries stay on their 2.x line until rawdata-client 3.0.0 is on Maven Central: rawdata
             2.x needs service-provider-api 2.x, and its 3.x needs 3.x, under the same JPMS module name, so the whole
             set moves in one step (.github/renovate.json holds them). -->
        <service-provider-api.version>2.0.1</service-provider-api.version>
        <dynamic-configuration.version>2.0.0</dynamic-configuration.version>
        <secrets-client-api.version>2.0.3</secrets-client-api.version>
        <secrets-provider.version>2.0.1</secrets-provider.version>
        <encryption-util.version>2.0.1</encryption-util.version>
        <rawdata-client.version>2.0.0</rawdata-client.version>

        <slf4j.version>2.0.20</slf4j.version>
        <log4j2.version>2.26.1</log4j2.version>
        <disruptor.version>4.0.0</disruptor.version>
        <jansi.version>2.4.3</jansi.version>
        <jackson.version>2.23.0</jackson.version>
        <jackson-annotations.version>2.23</jackson-annotations.version>
        <jackson-jq.version>1.3.0</jackson-jq.version>
        <commons-jexl3.version>3.2.1</commons-jexl3.version>
        <sulky-ulid.version>8.3.0</sulky-ulid.version>
        <classgraph.version>4.8.200</classgraph.version>
        <methanol.version>1.9.0</methanol.version>
        <byte-buddy.version>1.18.17</byte-buddy.version>
        <prometheus-simpleclient.version>0.16.0</prometheus-simpleclient.version>
        <bouncycastle.version>1.87</bouncycastle.version>
        <java-jwt.version>4.6.2</java-jwt.version>
        <undertow.version>2.4.4.Final</undertow.version>
        <freemarker.version>2.3.35</freemarker.version>
        <tika.version>3.3.0</tika.version>
        <lmdbjava.version>0.9.3</lmdbjava.version>
        <jffi.version>1.4.7</jffi.version>
        <javax-inject.version>1</javax-inject.version>
        <h2.version>2.5.252</h2.version>
        <snappy.version>1.1.10.12</snappy.version>
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
    </properties>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ove Ranheim</name>
            <email>ove.ranheim@gmail.com</email>
            <url>https://www.linkedin.com/in/overanheim/</url>
        </developer>
    </developers>

    <!-- The modules live in this repository: their url and scm are the project's, not <url>/<artifactId>. -->
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/descoped/data-collector-project.git</connection>
        <developerConnection>scm:git:git@github.com:descoped/data-collector-project.git</developerConnection>
        <url>https://github.com/descoped/data-collector-project/tree/master</url>
        <tag>HEAD</tag>
    </scm>

    <profiles>
        <!-- Releases to Maven Central through the Central Portal, by central-publishing-maven-plugin. Only releases:
             SNAPSHOTs are not published.
             Release (Ove approves each one): ./mvnw release:prepare release:perform
             Server `central` in ~/.m2/settings.xml holds the Portal user token and, for Maven 3.10, lists
             https://central.sonatype.com in repositoryOrigins. Releases are uploaded with autoPublish=false and
             published by hand in the Portal. -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!-- The samples are examples, never published. -->
                            <excludeArtifacts>data-collector-samples,data-collector-moveit-test-worker,data-collector-altinn3-test-worker,data-collector-ske-sirius-worker,data-collector-toll-tvinn-worker,enhetsregisteret-worker</excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Signing, required by Central for releases. gpg's default-key signs (see ~/.m2/NOTES.md). -->
        <profile>
            <id>sign</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.16</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- One SonarCloud project for the whole reactor; each module reports its own JaCoCo XML. -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.host.url>https://sonarcloud.io</sonar.host.url>
                <sonar.organization>descoped</sonar.organization>
                <sonar.projectKey>descoped_data-collector-project</sonar.projectKey>
                <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonarsource.scanner.maven</groupId>
                        <artifactId>sonar-maven-plugin</artifactId>
                        <version>5.9.0.7382</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all${lint.exclusions}</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                    <executions>
                        <!-- The tests are compiled into their module (patch mode), so the module's export lints would
                             apply to test classes; tests are not API. -->
                        <execution>
                            <id>default-testCompile</id>
                            <configuration>
                                <compilerArgs combine.children="append">
                                    <arg>-Xlint:-exports,-missing-explicit-ctor</arg>
                                </compilerArgs>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <doclint>all${doclint.exclusions}</doclint>
                        <failOnWarnings>true</failOnWarnings>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <tagNameFormat>@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <releaseProfiles>central,sign</releaseProfiles>
                        <goals>deploy</goals>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                                <!-- Sonatype's central-publishing-maven-plugin does not support Maven 4. -->
                                <requireMavenVersion>
                                    <version>[3.6.3,4)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
