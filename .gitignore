# Build output
target/
dependency-reduced-pom.xml
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
*.log
hs_err_pid*

# IDEs and OS
.idea/
*.iml
.sonarlint/
.vscode/
**/.DS_Store

# Never commit certificates, keys, secrets or local configuration. Business certificates, service-account keys and
# local overrides are read from these paths by the server, the samples and the tests.
**/*certs
**/*certs.zip
**/*certs.tgz
**/certs/
**/secret/
**/application-override.properties
**/application-ignore.properties

# Local data written by the server and the samples (rawdata filesystem provider, LMDB, dumps)
**/storage/
